---
import '../styles/global.css';
import Header from '../components/layout/Header.astro';
import Footer from '../components/layout/Footer.astro';

export interface Props {
  title?: string;
}

const { title = "Encontro Cultural Ouro Branco" } = Astro.props;
---
<!DOCTYPE html>
<html lang="pt-BR">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>
  </head>
  <body class="min-h-screen flex flex-col bg-slate-900 text-slate-50 antialiased selection:bg-blue-500/30">
    <Header />
    <slot />
    <Footer />
  </body>
</html>
