---
import Layout from '../layouts/Layout.astro';
import { artistas } from '../data/mock';
---

<Layout title="Artistas | Ouro Branco">
  <main class="container mx-auto px-4 py-16 flex-1">
    <div class="max-w-6xl mx-auto">
      <h1 class="text-4xl md:text-5xl font-bold mb-4 text-white text-center md:text-left">Artistas Confirmados</h1>
      <p class="text-lg text-slate-400 mb-12 text-center md:text-left">Conheça as atrações que farão a festa ser inesquecível.</p>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
        {artistas.map((artista) => (
          <article class="group relative rounded-2xl overflow-hidden bg-slate-800 border border-slate-700/50 hover:border-blue-500/50 transition-all duration-300 shadow-lg hover:shadow-blue-500/10">
            <div class="aspect-square overflow-hidden bg-slate-900">
              <img 
                src={artista.image} 
                alt={`Foto de ${artista.name}`}
                class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500 opacity-90 group-hover:opacity-100"
                loading="lazy"
              />
            </div>
            <div class="p-6 absolute bottom-0 left-0 right-0 bg-gradient-to-t from-slate-900 via-slate-900/80 to-transparent pt-12">
              <h2 class="text-2xl font-bold text-white mb-1">{artista.name}</h2>
              <div class="flex items-center justify-between">
                <span class="text-blue-400 font-medium text-sm">{artista.genre}</span>
                <span class="text-slate-300 text-sm bg-slate-800/80 px-3 py-1 rounded-full backdrop-blur-sm border border-slate-700/50">{artista.time}</span>
              </div>
            </div>
          </article>
        ))}
      </div>
    </div>
  </main>
</Layout>
