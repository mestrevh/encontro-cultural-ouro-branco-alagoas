---
import Layout from '../layouts/Layout.astro';
import Button from '../components/ui/Button.astro';
---

<Layout title="Encontro Cultural Ouro Branco">
  <main class="relative min-h-[calc(100vh-4rem)] flex items-center justify-center overflow-hidden">
    <!-- Ambient Background (Aurora style) -->
    <div class="absolute inset-0 pointer-events-none">
      <div class="absolute top-[-10%] left-[-10%] w-[40%] h-[40%] rounded-full bg-blue-600/30 blur-[120px] animate-float"></div>
      <div class="absolute bottom-[-10%] right-[-10%] w-[50%] h-[50%] rounded-full bg-indigo-600/20 blur-[150px] animate-float" style="animation-delay: 2s;"></div>
    </div>

    <!-- Hero Content -->
    <div class="container mx-auto px-4 relative z-10 text-center flex flex-col items-center">
      <div class="animate-fade-in opacity-0" style="animation-delay: 0.2s;">
        <span class="inline-block px-4 py-1.5 mb-6 text-sm font-semibold tracking-wider text-blue-400 bg-blue-900/30 border border-blue-500/30 rounded-full backdrop-blur-md shadow-lg shadow-blue-500/10">
          15ª EDIÇÃO • 15 A 17 DE JULHO
        </span>
      </div>
      
      <h1 class="text-4xl md:text-6xl lg:text-7xl font-black mb-6 tracking-tight animate-slide-up opacity-0" style="animation-delay: 0.4s;">
        Encontro Cultural <br class="hidden md:block"/>
        <span class="bg-gradient-to-r from-blue-400 via-indigo-400 to-purple-400 bg-clip-text text-transparent drop-shadow-sm">Ouro Branco</span>
      </h1>
      
      <p class="text-lg md:text-2xl text-slate-400 max-w-2xl mb-10 leading-relaxed font-light animate-slide-up opacity-0" style="animation-delay: 0.6s;">
        Sinta a energia, viva a tradição e celebre a cultura alagoana no maior festival de arte e música da nossa terra.
      </p>
      
      <div class="flex flex-col sm:flex-row items-center gap-6 animate-slide-up opacity-0" style="animation-delay: 0.8s;">
        <Button variant="primary" class="w-full sm:w-auto text-lg px-8 py-3.5 shadow-xl shadow-blue-500/20 hover:shadow-blue-500/40">Garantir Ingresso</Button>
        <a href="/programacao" class="w-full sm:w-auto">
          <Button variant="outline" class="w-full text-lg px-8 py-3.5 hover:bg-slate-800">Ver Programação</Button>
        </a>
      </div>
    </div>
  </main>
</Layout>
