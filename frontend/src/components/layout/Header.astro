---
import Button from '../ui/Button.astro';
---
<header class="sticky top-0 z-50 w-full border-b border-slate-800 bg-slate-900/80 backdrop-blur-md">
  <div class="container mx-auto px-4 h-16 flex items-center justify-between">
    <!-- Brand -->
    <a href="/" class="text-xl font-bold bg-gradient-to-r from-blue-400 to-blue-600 bg-clip-text text-transparent hover:opacity-80 transition-opacity">
      Ouro Branco
    </a>

    <!-- Desktop Nav -->
    <nav class="hidden md:flex items-center gap-8" aria-label="Main Navigation">
      <a href="/programacao" class="text-sm font-medium text-slate-300 hover:text-white transition-colors">Programação</a>
      <a href="/artistas" class="text-sm font-medium text-slate-300 hover:text-white transition-colors">Artistas</a>
      <a href="/sobre" class="text-sm font-medium text-slate-300 hover:text-white transition-colors">Sobre</a>
      <Button variant="primary">Comprar Ingressos</Button>
    </nav>

    <!-- Mobile Nav Toggle -->
    <button 
      class="md:hidden p-2 -mr-2 text-slate-300 hover:text-white focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-blue-500 rounded-md" 
      aria-label="Menu" 
      aria-expanded="false"
      id="mobile-menu-btn"
    >
      <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <line x1="4" x2="20" y1="12" y2="12"></line>
        <line x1="4" x2="20" y1="6" y2="6"></line>
        <line x1="4" x2="20" y1="18" y2="18"></line>
      </svg>
    </button>
  </div>
</header>
