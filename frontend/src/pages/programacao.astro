---
import Layout from '../layouts/Layout.astro';
import { agenda } from '../data/mock';
---

<Layout title="Programação do Evento | Ouro Branco">
  <main class="container mx-auto px-4 py-16 flex-1">
    <div class="max-w-4xl mx-auto">
      <h1 class="text-4xl md:text-5xl font-bold mb-4 text-white">Programação do Evento</h1>
      <p class="text-lg text-slate-400 mb-12">Confira a agenda completa do Encontro Cultural Ouro Branco.</p>

      <div class="space-y-12">
        {agenda.map((diaItem) => (
          <section class="bg-slate-800/50 rounded-2xl p-6 md:p-8 border border-slate-700/50 backdrop-blur-sm">
            <div class="mb-6 pb-4 border-b border-slate-700">
              <h2 class="text-2xl font-bold text-blue-400">{diaItem.dia}</h2>
              <p class="text-slate-400 mt-1">{diaItem.palco}</p>
            </div>
            
            <div class="space-y-4">
              {diaItem.shows.map((show) => (
                <div class="flex items-center gap-6 p-4 rounded-xl hover:bg-slate-700/30 transition-colors">
                  <div class="text-xl font-bold text-slate-300 w-20">{show.horario}</div>
                  <div class="flex-1">
                    <h3 class="text-xl font-semibold text-white">{show.artista}</h3>
                  </div>
                </div>
              ))}
            </div>
          </section>
        ))}
      </div>
    </div>
  </main>
</Layout>
